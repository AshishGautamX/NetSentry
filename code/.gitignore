network_auditor.db

# --- Environment & Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# --- Node.js & Frontend ---
node_modules/
*/node_modules/
frontend/node_modules/
dist/
*/dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
*/.vite/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Logs ---
logs/
*.log
backend/logs/

