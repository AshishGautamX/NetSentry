# Environment Configuration for AI-Driven Multi-Vendor Network Security Compliance Auditor
# SIH 2026 Problem Statement 26155

# AI Provider: "deterministic" (offline pattern & NLP core) or "gemini" (LLM augmented)
AI_PROVIDER=deterministic

# Optional: Google Gemini API Key (only required if AI_PROVIDER is set to "gemini")
# Leave empty to operate 100% offline using deterministic normalization and knowledge base
GEMINI_API_KEY=

# Database Connection (SQLite local file by default, PostgreSQL connection string compatible)
DATABASE_URL=sqlite:///./network_auditor.db

# Ingestion Constraints
MAX_UPLOAD_SIZE_BYTES=10485760

# Severity Risk Multipliers
RISK_WEIGHT_CRITICAL=10.0
RISK_WEIGHT_HIGH=7.0
RISK_WEIGHT_MEDIUM=4.0
RISK_WEIGHT_LOW=2.0
RISK_WEIGHT_INFO=0.0

# GitOps Webhook Integration (Milestone 2)
# Set GITHUB_WEBHOOK_SECRET to the secret configured in GitHub repo Settings -> Webhooks
# Leave empty in dev/demo mode to disable signature validation
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=

# Optional: Personal Access Tokens for private repository file fetching
# Requires repo:read scope on GitHub or read_repository on GitLab
GITHUB_TOKEN=
GITLAB_TOKEN=
